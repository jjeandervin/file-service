{
  "Database": {
    "ApplyMigrations": false
  },
  "FileStorage": {
    "BucketName": "",
    "Region": "",
    "KeyPrefix": "files",
    "UploadUrlLifetimeMinutes": 5,
    "DownloadUrlLifetimeMinutes": 5,
    "MaxFileBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "VerifyContentSignature": true,
    "CheckBucketOnReady": false,
    "PendingCleanupEnabled": true,
    "PendingCleanupIntervalMinutes": 60,
    "PendingUploadTtlHours": 24
  },
  "InternalApi": {
    "ApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
