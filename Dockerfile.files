FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/HooviePack.Files.Domain/HooviePack.Files.Domain.csproj src/HooviePack.Files.Domain/
COPY src/HooviePack.Files.Api/HooviePack.Files.Api.csproj src/HooviePack.Files.Api/
RUN dotnet restore src/HooviePack.Files.Api/HooviePack.Files.Api.csproj

COPY src/HooviePack.Files.Domain/ src/HooviePack.Files.Domain/
COPY src/HooviePack.Files.Api/ src/HooviePack.Files.Api/
RUN dotnet publish src/HooviePack.Files.Api/HooviePack.Files.Api.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build --chown=app:app /app/publish .

USER app
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8080/health/ready || exit 1

ENTRYPOINT ["dotnet", "HooviePack.Files.Api.dll"]
